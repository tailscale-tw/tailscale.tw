{
  "name": "tailscale-tw",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "lint:text": "autocorrect --lint src/content/",
    "fix:text": "autocorrect --fix src/content/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview:cf": "astro build && wrangler dev",
    "deploy": "astro check && astro build && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.17.0",
    "@iconify-json/ph": "^1.2.0",
    "astro": "7.3.1",
    "astro-og-canvas": "^0.13.0",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/language-server": "2.16.13",
    "@tailwindcss/vite": "^4.1.4",
    "autocorrect-node": "^2.14.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.71.1",
    "wrangler": "^4.95.0"
  }
}
